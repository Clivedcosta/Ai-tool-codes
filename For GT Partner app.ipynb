# For App GT Partner ... new edited code
# Enhanced Eligibility Analysis - Continuous Forest, 2m Canopy & Water Bodies
# Accepts polygon from app (lat/lng JSON) — returns JSON result

import geemap
import ee
import json

ee.Initialize()

Map = geemap.Map()
Map.add_basemap('HYBRID')

Dynamic_World = ee.ImageCollection('GOOGLE/DYNAMICWORLD/V1')
Sentinel2     = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
scale = 10

# ============================================================
# Accept polygon from app as lat/lng JSON array
# ============================================================

def create_roi_from_coords(coords_json):
    if isinstance(coords_json, str):
        coords = json.loads(coords_json)
    else:
        coords = coords_json

    ee_coords = [[pt["lng"], pt["lat"]] for pt in coords]

    if ee_coords[0] != ee_coords[-1]:
        ee_coords.append(ee_coords[0])

    geometry = ee.Geometry.Polygon([ee_coords])
    return ee.FeatureCollection([ee.Feature(geometry)])


# ── Paste / inject your polygon here ──────────────────────────────────────────
polygon_from_app = [
    {"lat": 24.300745253658558, "lng": 82.82732952386141},
    {"lat": 24.301204218917405, "lng": 82.82751224935055},
    {"lat": 24.30096831953766,  "lng": 82.82815631479025},
    {"lat": 24.300406070543016, "lng": 82.82793637365103},
    {"lat": 24.300745253658558, "lng": 82.82732952386141},  # closing point (optional)
]
polygon_id = "polygon_1"   # ← set a unique ID for this polygon
# ──────────────────────────────────────────────────────────────────────────────

roi          = create_roi_from_coords(polygon_from_app)
roi_geometry = roi.geometry()
Map.centerObject(roi)

# ============================================================
# 1. YEARLY LAND COVER (Dynamic World 2016–2024)
# ============================================================
analysis_years = list(range(2016, 2025))

def get_yearly_landcover(year):
    return (Dynamic_World
            .filterBounds(roi)
            .filterDate(f'{year}-01-01', f'{year}-12-31')
            .select('label')
            .mode())

print("Processing land cover data 2016-2024...")
yearly_landcover = {yr: get_yearly_landcover(yr) for yr in analysis_years}

# ============================================================
# 2. FOREST EXCLUSION
#    Continuous forest = Trees (label 1) in 3+ of 9 years
#    Also exclude current Trees in 2024
# ============================================================
forest_masks = {yr: yearly_landcover[yr].eq(1) for yr in analysis_years}

total_forest_years = forest_masks[2016]
for yr in range(2017, 2025):
    total_forest_years = total_forest_years.add(forest_masks[yr])

continuous_forest   = total_forest_years.gte(3)
current_forest_2024 = yearly_landcover[2024].eq(1)

# ============================================================
# 3. CANOPY HEIGHT EXCLUSION (>= 2m)
# ============================================================
canopy_height    = (ee.ImageCollection('projects/meta-forest-monitoring-okw37/assets/CanopyHeight')
                    .mosaic()
                    .clip(roi_geometry))
canopy_exclusion = canopy_height.gte(2)

# ============================================================
# 4. WATER EXCLUSION — 2024 CURRENT ONLY
#    DW Water class (label 0) for 2024
#    + NDWI > 0.2 on 2024 Sentinel-2 (catches small/unclassified water bodies)
# ============================================================
print("Computing water mask (2024)...")

current_water_dw = yearly_landcover[2024].eq(0)

s2_2024 = (Sentinel2
           .filterBounds(roi)
           .filterDate('2024-01-01', '2024-12-31')
           .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20))
           .select(['B3', 'B8'])
           .median()
           .clip(roi_geometry))

ndwi            = s2_2024.normalizedDifference(['B3', 'B8']).rename('NDWI')
water_exclusion = current_water_dw.Or(ndwi.gt(0.2))

# ============================================================
# 5. FINAL ELIGIBILITY
#    Hard-clipped to roi_geometry so eligible ha <= total ha always
# ============================================================
final_eligible = (continuous_forest.Not()
                  .And(current_forest_2024.Not())
                  .And(canopy_exclusion.Not())
                  .And(water_exclusion.Not())
                  .clip(roi_geometry))

# ============================================================
# 6. VECTORISE
# ============================================================
def clip_eligible_to_polygon(feature):
    geometry = feature.geometry()
    eligible_vectors = final_eligible.clip(geometry).selfMask().reduceToVectors(
        geometry=geometry,
        scale=scale,
        geometryType='polygon',
        crs='EPSG:4326',
        bestEffort=True,
        maxPixels=1e13
    )
    return eligible_vectors.map(lambda f: f.set(feature.toDictionary()))

all_eligible_parts = roi.map(clip_eligible_to_polygon).flatten()

# ============================================================
# 7. VISUALISATION
# ============================================================
vis_params_dw = {
    'bands': ['label'],
    'palette': ['#419BDF','#397D49','#88B053','#7A87C6','#E49635',
                '#DFC35A','#C4281B','#A59B8F','#B39FE1'],
    'min': 0, 'max': 8
}

Map.addLayer(yearly_landcover[2016].clip(roi_geometry), vis_params_dw, '2016 Baseline', False)
Map.addLayer(yearly_landcover[2024].clip(roi_geometry), vis_params_dw, '2024 Current')
Map.addLayer(continuous_forest.selfMask().clip(roi_geometry),
             {'palette': ['red']}, 'Continuous Forest (3+ years)', False)
Map.addLayer(canopy_height,
             {'min': 0, 'max': 20, 'palette': ['white', 'green']}, 'Canopy Height (m)', False)
Map.addLayer(water_exclusion.selfMask().clip(roi_geometry),
             {'palette': ['#0000FF']}, 'Excl: Water Bodies (2024)', False)
Map.addLayer(final_eligible.selfMask(),
             {'palette': ['00FF00']}, 'Eligible Areas (Raster)')
Map.addLayer(all_eligible_parts,
             {'color': '00FF00', 'fillColor': '00FF0044'}, 'Eligible Areas (Vector)')

# ============================================================
# 8. AREA CALCULATIONS
#    All reducers bounded by roi_geometry — eligible ha <= total ha always
# ============================================================
print("=== AREA ANALYSIS ===")

total_ha = round(roi_geometry.area().divide(10000).getInfo(), 4)
print(f"Total area: {total_ha:.2f} hectares")

def get_ha(image, band='label'):
    val = (image.multiply(ee.Image.pixelArea())
               .reduceRegion(
                   reducer=ee.Reducer.sum(),
                   geometry=roi_geometry,
                   scale=scale,
                   maxPixels=1e13
               ).get(band))
    return round(ee.Number(val).divide(10000).getInfo(), 4)

forest_by_year = {}
print("\nForest area by year:")
for yr in analysis_years:
    ha = get_ha(forest_masks[yr])
    forest_by_year[str(yr)] = ha
    print(f"  {yr}: {ha:.2f} ha")

continuous_forest_ha = get_ha(continuous_forest)
current_forest_ha    = get_ha(current_forest_2024)
canopy_excl_ha       = get_ha(canopy_exclusion, 'cover_code')
water_excl_ha        = get_ha(water_exclusion)
final_eligible_ha    = get_ha(final_eligible)
total_excluded_ha    = round(total_ha - final_eligible_ha, 4)
eligible_pct         = round(final_eligible_ha / total_ha * 100, 2) if total_ha > 0 else 0

print(f"\n=== EXCLUSION SUMMARY ===")
print(f"Total area                           : {total_ha:.2f} ha")
print(f"Excl - Continuous forest (3+ yrs)    : {continuous_forest_ha:.2f} ha")
print(f"Excl - Current forest (2024)          : {current_forest_ha:.2f} ha")
print(f"Excl - Canopy height >=2m            : {canopy_excl_ha:.2f} ha")
print(f"Excl - Water bodies (2024)            : {water_excl_ha:.2f} ha")
print(f"\n{'='*60}")
print(f"FINAL ELIGIBLE AREA FOR A/R PROJECT: {final_eligible_ha:.2f} HECTARES")
print(f"{'='*60}")
print(f"\n=== BREAKDOWN ===")
print(f"Total area     : {total_ha:.2f} ha")
print(f"Total excluded : {total_excluded_ha:.2f} ha")
print(f"Eligible area  : {final_eligible_ha:.2f} ha ({eligible_pct}% of total)")

# ============================================================
# 9. JSON OUTPUT
# ============================================================
result = {
    "polygon_id": polygon_id,
    "summary": {
        "total_ha":      total_ha,
        "eligible_ha":   final_eligible_ha,
        "ineligible_ha": total_excluded_ha,
        "eligible_pct":  eligible_pct,
    },
    "exclusions": {
        "continuous_forest_ha":   continuous_forest_ha,
        "current_forest_2024_ha": current_forest_ha,
        "canopy_gte_2m_ha":       canopy_excl_ha,
        "water_bodies_2024_ha":   water_excl_ha,
    },
    "forest_area_by_year_ha": forest_by_year,
    "methodology": {
        "continuous_forest": "Trees label (DW) in 3+ of 9 years (2016-2024)",
        "current_forest":    "Trees label (DW) in 2024",
        "canopy":            "Canopy height >= 2m (Meta canopy height dataset)",
        "water":             "DW Water label (2024) + NDWI > 0.2 (2024 Sentinel-2)",
        "area_constraint":   "Eligible area hard-clipped to polygon — eligible ha <= total ha always"
    },
    "eligible_geometry": all_eligible_parts.getInfo()  # full GeoJSON of eligible patches
}

print("\n" + "="*60)
print("JSON OUTPUT")
print("="*60)
print(json.dumps(result, indent=2))

# ============================================================
# 10. EXPORT (KML to Drive)
# ============================================================
export_task = ee.batch.Export.table.toDrive(
    collection=all_eligible_parts,
    description='lot3appsbd3',
    folder='SBDapp1_1',
    fileFormat='KML'
)
export_task.start()
print(f"\nExport started: eligible_areas.kml")

Map.addLayerControl()
Map
